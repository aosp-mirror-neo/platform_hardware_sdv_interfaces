package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// AIDL internal APIs for SDV Agents.
aidl_interface {
    name: "google.sdv.service_bundles_registry",
    srcs: [
        "google/sdv/service_bundles_registry/**/*.aidl",
    ],
    host_supported: true,
    product_available: true,
    vendor_available: true,
    backend: {
        java: {
            enabled: false, // java isn't supported on SDV
        },
        cpp: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
        ndk: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
        rust: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
            gen_mockall: true,
            additional_rustlibs: [
                "libmockall",
            ],
        },
    },
    stability: "vintf",
    owner: "google",
    frozen: true,
    min_sdk_version: "35",
    versions_with_info: [
        {
            version: "1",
        },
        {
            version: "2",
            imports: [],
        },

    ],

    visibility: [
        "//system/software_defined_vehicle/core_services:__subpackages__",
        "//system/tools/aidl/build:__subpackages__",
    ],
}
