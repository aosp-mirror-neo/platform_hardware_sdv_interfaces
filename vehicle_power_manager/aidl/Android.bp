package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "sdv_vpm_agent_vintf_fragments",
    srcs: ["google.sdv.vpm-service.xml"],
}

aidl_interface {
    name: "google.sdv.vpm",
    srcs: ["google/sdv/vpm/*.aidl"],
    stability: "vintf",
    owner: "google",
    visibility: [
        // Dependencies to all aidl_interface
        "//system/tools/aidl/build",
        "//system/software_defined_vehicle/vpm:__subpackages__",
        "//system/software_defined_vehicle/orchestration:__subpackages__",
        "//system/software_defined_vehicle/health_monitor:__subpackages__",
        "//system/software_defined_vehicle/update_manager:__subpackages__",
        "//system/software_defined_vehicle/middleware/data_tunnel:__subpackages__",
        "//system/software_defined_vehicle/middleware/service_discovery:__subpackages__",
        "//system/software_defined_vehicle/sdv_gateway:__subpackages__",
        "//system/software_defined_vehicle/telemetry:__subpackages__",
        "//system/software_defined_vehicle/samples/vpm/power_state_client",
    ],
    backend: {
        rust: {
            enabled: true,
            gen_mockall: true,
            additional_rustlibs: [
                "libmockall",
            ],
        },
        ndk: {
            enabled: true,
            apex_available: [
                "//apex_available:anyapex",
                "//apex_available:platform",
            ],
        },
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    host_supported: true,
    vendor_available: true,
    system_ext_specific: true,
    min_sdk_version: "34",
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],

}
