package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// TODO: b/362862853 - Determine if this can be in system/.
aidl_interface {
    name: "google.sdv.gateway",
    vendor_available: true,
    product_available: true,
    system_ext_specific: true,
    srcs: ["google/sdv/gateway/**/*.aidl"],
    imports: [
        "android.hardware.common.fmq-V1",
        "android.hardware.common-V2",
        "google.sdv.identity-V2",
        "google.sdv.authz-V2",
        "google.sdv.data_tunnel-V2",
        "google.sdv.service_discovery.common-V2",
        "google.sdv.service_discovery.discovery-V2",
    ],
    stability: "vintf",
    owner: "google",
    frozen: false,
    min_sdk_version: "35",
    backend: {
        java: {
            enabled: false,
        },
        rust: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [
                "android.hardware.common.fmq-V1",
                "android.hardware.common-V2",
                "google.sdv.identity-V1",
                "google.sdv.authz-V1",
                "google.sdv.data_tunnel-V1",
                "google.sdv.service_discovery.common-V1",
                "google.sdv.service_discovery.discovery-V1",
            ],
        },
        {
            version: "2",
            imports: [
                "android.hardware.common.fmq-V1",
                "android.hardware.common-V2",
                "google.sdv.identity-V1",
                "google.sdv.authz-V1",
                "google.sdv.data_tunnel-V1",
                "google.sdv.service_discovery.common-V1",
                "google.sdv.service_discovery.discovery-V1",
            ],
        },

    ],

}

aidl_interface {
    name: "google.sdv.privileged.gatewaynetworking",
    vendor_available: true,
    product_available: true,
    system_ext_specific: true,
    srcs: ["google/sdv/privileged/gatewaynetworking/*.aidl"],
    stability: "vintf",
    owner: "google",
    frozen: false,
    min_sdk_version: "35",
    backend: {
        java: {
            enabled: false,
        },
        rust: {
            enabled: true,
        },
        ndk: {
            // Enabled because this interface is served by the SDV Gateway service and consumed by
            // the (Java) SDV Gateway Networking service (through JNI).
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
        {
            version: "2",
            imports: [],
        },

    ],

}

aidl_interface {
    name: "google.sdv.privileged.identity",
    vendor_available: true,
    product_available: true,
    system_ext_specific: true,
    srcs: ["google/sdv/privileged/identity/*.aidl"],
    imports: [
        "google.sdv.identity-V2",
    ],
    stability: "vintf",
    owner: "google",
    frozen: false,
    min_sdk_version: "35",
    backend: {
        java: {
            enabled: false,
        },
        rust: {
            // Enabled because the implementation is provided by SD agent.
            enabled: true,
        },
        ndk: {
            // Enabled because this interface is intended for SDV Gateway service consumption.
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: ["google.sdv.identity-V1"],
        },
    ],

}

aidl_interface {
    name: "google.sdv.privileged.service_discovery",
    vendor_available: true,
    product_available: true,
    system_ext_specific: true,
    srcs: ["google/sdv/privileged/service_discovery/*.aidl"],
    imports: [
        "google.sdv.service_discovery.common-V2",
        "google.sdv.service_discovery.discovery-V2",
        "google.sdv.identity-V2",
    ],
    stability: "vintf",
    owner: "google",
    frozen: false,
    min_sdk_version: "35",
    backend: {
        java: {
            enabled: false,
        },
        rust: {
            // Enabled because the implementation is provided by SD agent.
            enabled: true,
        },
        ndk: {
            // Enabled because this interface is intended for SDV Gateway service consumption.
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [
                "google.sdv.service_discovery.common-V1",
                "google.sdv.service_discovery.discovery-V1",
                "google.sdv.identity-V1",
            ],
        },
    ],

}

filegroup {
    name: "sdv_gateway_vintf_fragments",
    srcs: [
        "google.sdv.gateway.xml",
    ],
}

vintf_fragment {
    name: "google.sdv.gateway.xml",
    src: "google.sdv.gateway.xml",
    vendor: true,
}

filegroup {
    name: "sdv_privileged_gatewaynetworking_vintf_fragments",
    srcs: [
        "google.sdv.privileged.gatewaynetworking.xml",
    ],
}

vintf_fragment {
    name: "google.sdv.privileged.gatewaynetworking.xml",
    src: "google.sdv.privileged.gatewaynetworking.xml",
    vendor: true,
}
