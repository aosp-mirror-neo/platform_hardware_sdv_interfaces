    },
    versions_with_info: [
        {
            version: "1",
            imports: [
                "google.sdv.service_discovery.common-aidl-V1",
                "google.sdv.service_discovery.discovery-aidl-V1",
                "google.sdv.identity-aidl-V1",
            ],
