package google.sdv.gateway;

import google.sdv.gateway.PublicKey;

/**
 * InitCommsParams contains the parameters needed to call SDV Gateway Session AIDL's initComms API.
 *
 * TODO: b/360243025 - Applications should not need to pass the serverPackageName, the
 * serverPackageName should be deduced programmatically.
 */

@VintfStability
parcelable InitCommsParams {
    /**
     * A public key generated by the application needed to create a Service Identity with SDV
     * service discovery.
     */
    PublicKey identityKey;
    /** The package name of the calling application. */
    @utf8InCpp String sdvPackageName;
    /** The service bundle name of the calling application's Activity or subclass. */
    @utf8InCpp String serviceBundleName;
    /** The name of the service instance. */
    @nullable String serviceInstanceName;
    /** The termination of the process hosting the IBinder removes the created Service Identity. */
    @nullable IBinder linkToDeath;
}
