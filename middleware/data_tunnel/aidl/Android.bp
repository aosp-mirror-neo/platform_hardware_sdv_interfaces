package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "google.sdv.data_tunnel",
    vendor_available: true,
    product_available: true,
    system_ext_specific: true,
    visibility: [
        "//system/tools/aidl/build",
        "//system/software_defined_vehicle/middleware:__subpackages__",
        "//system/software_defined_vehicle/samples/sdv_gateway:__subpackages__",
        "//system/software_defined_vehicle/samples/vhal_proxy:__subpackages__",
        "//system/software_defined_vehicle/sdv_gateway:__subpackages__",
        "//system/software_defined_vehicle/core_services:__subpackages__",
        "//hardware/sdv/interfaces/middleware:__subpackages__",
        "//hardware/sdv/interfaces/sdv_gateway:__subpackages__",
    ],
    srcs: [
        "google/sdv/data_tunnel/*.aidl",
    ],
    imports: [
        "android.hardware.common.fmq-V1",
        "android.hardware.common-V2",
        "google.sdv.service_discovery.common-V2",
        "google.sdv.identity-V2",
    ],
    stability: "vintf",
    owner: "google",
    min_sdk_version: "35",
    backend: {
        rust: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
        ndk: {
            enabled: true,
            apex_available: [
                "//apex_available:anyapex",
                "//apex_available:platform",
            ],
        },
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    frozen: false,
    versions_with_info: [
        {
            version: "1",
            imports: [
                "android.hardware.common.fmq-V1",
                "android.hardware.common-V2",
                "google.sdv.service_discovery.common-V1",
                "google.sdv.identity-V1",
            ],
        },
    ],
}

filegroup {
    name: "dt_agent_vintf_fragments",
    srcs: [
        "google.sdv.data_tunnel-service.xml",
    ],
}

vintf_fragment {
    name: "google.sdv.data_tunnel-service.xml",
    src: "google.sdv.data_tunnel-service.xml",
    system_ext_specific: true,
}
