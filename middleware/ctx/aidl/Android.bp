package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "google.sdv.comms",
    srcs: ["google/sdv/comms/*.aidl"],
    stability: "vintf",
    owner: "google",
    imports: [
        "google.sdv.identity-V1",
        "google.sdv.data_tunnel-V1",
        "google.sdv.rpc-V1",
        "google.sdv.service_discovery.discovery-V1",
    ],
    backend: {
        rust: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
        ndk: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    product_available: true,
    vendor_available: true,
    versions_with_info: [
        {
            version: "1",
            imports: [
                "google.sdv.identity-V1",
                "google.sdv.data_tunnel-V1",
                "google.sdv.rpc-V1",
                "google.sdv.service_discovery.discovery-V1",
            ],
        },
    ],
    frozen: true,
}
