package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface_defaults {
    name: "sdv_rpc_aidl_defaults",
    host_supported: false,
    system_ext_specific: true,
}

aidl_interface {
    // This public interface is for the SDV Service Discovery SDK that
    // registers/unregisters services.
    name: "google.sdv.rpc",
    defaults: [
        "sdv_rpc_aidl_defaults",
    ],
    srcs: ["google/sdv/rpc/*.aidl"],
    imports: [
        "google.sdv.service_discovery.common-V2",
        "google.sdv.identity-V2",
    ],
    stability: "vintf",
    owner: "google",
    backend: {
        rust: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
        ndk: {
            enabled: true,
            apex_available: [
                "//apex_available:anyapex",
                "//apex_available:platform",
            ],
        },
        cpp: {
            enabled: true,
        },
        java: {
            enabled: false,
        },
    },
    product_available: true,
    vendor_available: true,
    min_sdk_version: "34",
    frozen: false,
    versions_with_info: [
        {
            version: "1",
            imports: [
                "google.sdv.service_discovery.common-V1",
                "google.sdv.identity-V1",
            ],
        },
    ],

}

filegroup {
    name: "rpc_agent_vintf_fragments",
    srcs: ["google.sdv.rpc-service.xml"],
}
