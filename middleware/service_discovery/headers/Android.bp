package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_headers {
    name: "libsdv_comms_sd_hdrs",
    local_include_dirs: ["current"],
    export_include_dirs: ["current"],
    defaults: ["sdv_comms_hdrs@cc_defaults"],
    export_header_lib_headers: ["libsdv_comms_common_hdrs"],
    header_libs: ["libsdv_comms_common_hdrs"],
    min_sdk_version: "34",
}
