package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface_defaults {
    name: "sdv_sd_aidl_defaults",
    host_supported: false,
    system_ext_specific: true,
}

aidl_interface {
    // Common service discovery data types.
    name: "google.sdv.identity",
    defaults: ["sdv_sd_aidl_defaults"],
    srcs: ["google/sdv/identity/**/*.aidl"],
    stability: "vintf",
    owner: "google",
    backend: {
        rust: {
            gen_mockall: true,
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
            additional_rustlibs: [
                "libmockall",
            ],
        },
        ndk: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
        cpp: {
            enabled: true,
        },
        java: {
            enabled: false,
        },
    },
    product_available: true,
    vendor_available: true,
    host_supported: true,
    frozen: true,
    min_sdk_version: "34",
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
        {
            version: "2",
            imports: [],
        },

    ],
}

aidl_interface {
    // Common service discovery data types.
    name: "google.sdv.service_discovery.common",
