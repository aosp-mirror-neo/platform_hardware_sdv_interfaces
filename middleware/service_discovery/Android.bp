            ],
        },
        cpp: {
            enabled: true,
        },
        java: {
            enabled: false,
        },
    },
    product_available: true,
    vendor_available: true,
    frozen: true,
    min_sdk_version: "34",
    versions_with_info: [
        {
            version: "1",
            imports: ["google.sdv.identity-V1"],
        },
        {
            version: "2",
            imports: ["google.sdv.identity-V2"],
        },

    ],
}

