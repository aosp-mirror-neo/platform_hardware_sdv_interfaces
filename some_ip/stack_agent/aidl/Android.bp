package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "google.sdv.someip-aidl",
    vendor_available: true,
    host_supported: true,
    srcs: ["google/sdv/someip/*.aidl"],
    stability: "vintf",
    owner: "google",
    backend: {
        java: {
            enabled: false,
        },
        rust: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
            ],
        },
        cpp: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
            ],
        },
    },
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
        {
            version: "2",
            imports: [],
        },

    ],

}

filegroup {
    name: "sdv_someip_stack_agent_vintf_fragments",
    srcs: ["google.sdv.someip-service.xml"],
}
