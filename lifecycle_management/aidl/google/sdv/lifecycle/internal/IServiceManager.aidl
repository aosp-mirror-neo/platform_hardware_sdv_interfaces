package google.sdv.lifecycle.internal;

import google.sdv.identity.ServiceFqin;
import google.sdv.lifecycle.internal.IService;

/**
 * An interface that enables service bundle runner processes to register for lifecycle events
 * generated by the Lifecycle manager.
 *
 * **Common Error conditions**
 * - `ResponseCode::PERMISSION_DENIED` - if the callers do not have permission.
 * - `ResponseCode::INTERNAL_ERROR` - something internal failed, info in the error msg.
 */
@VintfStability
interface IServiceManager {
    /**
     * Register a service bundle process.
     *
     * **Error conditions**
     *
     * @param fqin FQIN of the service bundle.
     * @param service callback that is invoked when service bundle state change is updated by
     *         orchestrator.
     */
    void registerService(in ServiceFqin fqin, IService service);

    /**
     * Unregister a service bundle process.
     *
     * **Error conditions**
     *
     * @param fqin FQIN of the service bundle.
     */
    void unregisterService(in ServiceFqin fqin);

    /**
     * Used to verify that the parent process that created a service is this manager
     *
     * **Error conditions**
     *
     * @return the PID of the Lifecycle manager process.
     */
    long getPid();
}
