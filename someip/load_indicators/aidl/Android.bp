package {
    default_applicable_licenses: ["sdv_license"],
}

aidl_interface {
    name: "google.sdv.someip_load_indicators",
    srcs: [
        "google/sdv/someip_load_indicators/*.aidl",
    ],
    stability: "vintf",
    system_ext_specific: true,
    owner: "google",
    backend: {
        java: {
            enabled: false, // java isn't supported on SDV
        },
        cpp: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
        rust: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
    },
    frozen: true,
    product_available: true,
    vendor_available: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],

}
